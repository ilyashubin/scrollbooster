{
  "name": "scrollbooster",
  "description": "Enjoyable content drag-to-scroll library",
  "version": "3.0.2",
  "author": "Ilya Shubin <pixelwake@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/scrollbooster.min.js",
  "jsdelivr": "./dist/scrollbooster.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/scrollbooster.min.js": "./dist/scrollbooster.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc",
    "start": "pnpm run --parallel \"/^start:/\"",
    "start:build": "tsdown --watch",
    "start:serve": "vite --host 0.0.0.0 --open",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyashubin/scrollbooster.git"
  },
  "keywords": [
    "drag",
    "draggable",
    "scroll",
    "scrollable",
    "UI",
    "microlibrary"
  ],
  "homepage": "https://ilyashubin.github.io/scrollbooster",
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "~1.63.0",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vite": "~8.3.3",
    "vitest": "^5.0.3"
  }
}
