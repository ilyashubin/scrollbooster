{
  "name": "scrollbooster",
  "description": "Enjoyable content drag-to-scroll library",
  "version": "3.0.2",
  "author": "Ilya Shubin <pixelwake@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/scrollbooster.min.js",
  "jsdelivr": "./dist/scrollbooster.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/scrollbooster.min.js": "./dist/scrollbooster.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project unit --project chromium",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./dist/scrollbooster.min.js && size-limit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:package",
    "changeset": "changeset",
    "start": "pnpm run --parallel \"/^start:/\"",
    "start:build": "tsdown --watch",
    "start:serve": "vite --host 0.0.0.0 --open",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyashubin/scrollbooster.git"
  },
  "keywords": [
    "drag",
    "draggable",
    "scroll",
    "scrollable",
    "UI",
    "microlibrary"
  ],
  "homepage": "https://ilyashubin.github.io/scrollbooster",
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "14.1.0",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "publint": "0.3.25",
    "size-limit": "14.1.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
